amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["dprint"] = (Builtins.dprint) {
    glob = "**/*.{json,jsonc,md,yaml,yml,toml}"
  }
  ["go-fmt"] = Builtins.go_fmt
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["zizmor"] = (Builtins.zizmor) {
    glob = ".github/{actions,workflows}/**/*.{yaml,yml}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["post-tool-use"] {
    fix = true
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
